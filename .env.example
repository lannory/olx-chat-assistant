# ===== Загальне =====
NODE_ENV=production
LOG_LEVEL=info
# HTTP-сервер (OAuth callback + /health)
PORT=3000
HOST=0.0.0.0
# Файл SQLite (у Docker — всередині volume /app/data)
DB_PATH=./data/olx-bot.db

# ===== OLX Partner API =====
# Ключі з developer.olx.ua (приходять на пошту після схвалення застосунку)
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=
# Має ТОЧНО збігатися з redirect URI, зареєстрованим на developer.olx.ua (тільки HTTPS, не localhost)
OLX_REDIRECT_URI=https://bot.example.com/oauth/callback
OLX_BASE_URL=https://www.olx.ua
OLX_SCOPE=v2 read write

# ===== Логіка =====
# Інтервал опитування OLX, секунд (мінімум 30)
POLL_INTERVAL_SEC=90
# draft — лише чернетки з кнопками; auto — шаблонні відповіді йдуть одразу
MODE=draft
# Не відповідати автоматично, якщо ви писали в треді за останні N хвилин
OWNER_COOLDOWN_MIN=30
# Тихі години (за TIMEZONE): у режимі auto відповіді відкладаються до кінця вікна. Порожньо = вимкнено
QUIET_HOURS=23-8
TIMEZONE=Europe/Kyiv
# Скільки останніх повідомлень треду показувати в Telegram (1–10)
TG_HISTORY_SIZE=5

# Оплата для шаблону про Нову Пошту
SHIPPING_COD=true
SHIPPING_PREPAY=true

# Шляхи до шаблонів і нотаток по оголошеннях (редагуються без перезапуску)
TEMPLATES_PATH=./config/templates.json
ADVERTS_CONFIG_PATH=./config/adverts.config.json

# ===== Telegram =====
# Токен від @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш chat_id (кілька — через кому). Решту чатів бот ігнорує
TELEGRAM_ALLOWED_CHAT_IDS=



# ===== Лише для docker compose --profile https (Caddy з автоматичним HTTPS) =====
DOMAIN=bot.example.com
